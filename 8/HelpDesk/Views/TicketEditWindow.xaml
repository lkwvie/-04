<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Редактирование заявки"
        Width="460"
        Height="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="Редактирование заявки"
                       FontSize="22"
                       FontWeight="Bold"/>

            <TextBlock x:Name="TicketNumber"/>

            <TextBlock Text="Категория"
                       Margin="0,10,0,0"/>

            <ComboBox x:Name="CategoryComboBox"
                      SelectedIndex="0"
                      Height="35">

                <ComboBoxItem Content="Выберите категорию"/>
                <ComboBoxItem Content="Оборудование"/>
                <ComboBoxItem Content="Программное обеспечение"/>
                <ComboBoxItem Content="Сеть"/>
                <ComboBoxItem Content="Учётная запись"/>
                <ComboBoxItem Content="Периферия"/>
                <ComboBoxItem Content="Другое"/>

            </ComboBox>

            <TextBlock Text="Описание проблемы"
                       Margin="0,10,0,0"/>

            <TextBox x:Name="DescriptionTextBox"
                     Height="100"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>

            <TextBlock Text="Приоритет"
                       Margin="0,10,0,0"/>

            <ComboBox x:Name="PriorityComboBox"
                      SelectedIndex="1"
                      Height="35">

                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Высокий"/>

            </ComboBox>

            <TextBlock Text="Статус"/>

            <ComboBox x:Name="StatusComboBox"
                      SelectedIndex="0"
                      Height="35">

                <ComboBoxItem Content="Новая"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Выполнена"/>
                <ComboBoxItem Content="Отклонена"/>

            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button x:Name="SaveButton"
                        Content="Сохранить изменения"
                        Click="SaveButton_Click"/>

                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Click="CancelButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Window>